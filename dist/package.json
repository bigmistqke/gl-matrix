{
  "version": "3.4.4",
  "name": "gl-matrix",
  "description": "Javascript Matrix and Vector library for High Performance WebGL apps",
  "sideEffects": false,
  "type": "module",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "./common": {
      "types": "./esm/index.d.ts",
      "default": "./esm/common.js"
    },
    "./mat2": {
      "types": "./esm/index.d.ts",
      "default": "./esm/mat2.js"
    },
    "./mat2d": {
      "types": "./esm/index.d.ts",
      "default": "./esm/mat2d.js"
    },
    "./mat3": {
      "types": "./esm/index.d.ts",
      "default": "./esm/mat3.js"
    },
    "./mat4": {
      "types": "./esm/index.d.ts",
      "default": "./esm/mat4.js"
    },
    "./quat": {
      "types": "./esm/index.d.ts",
      "default": "./esm/quat.js"
    },
    "./quat2": {
      "types": "./esm/index.d.ts",
      "default": "./esm/quat2.js"
    },
    "./vec2": {
      "types": "./esm/index.d.ts",
      "default": "./esm/vec2.js"
    },
    "./vec3": {
      "types": "./esm/index.d.ts",
      "default": "./esm/vec3.js"
    },
    "./vec4": {
      "types": "./esm/index.d.ts",
      "default": "./esm/vec4.js"
    }
  },
  "homepage": "http://glmatrix.net",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/toji/gl-matrix/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toji/gl-matrix.git"
  },
  "contributors": [
    {
      "name": "Brandon Jones",
      "email": "tojiro@gmail.com"
    },
    {
      "name": "Colin MacKenzie IV",
      "email": "sinisterchipmunk@gmail.com"
    }
  ]
}